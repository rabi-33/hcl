# Primary AI (Google Gemini 2.5 Flash - Vision & Q&A)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional Live Citizen Email Alerts (SMTP - works directly on Azure App Service)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional Azure Logic App / Event Grid / Teams Webhook URL
AZURE_WEBHOOK_URL=

# Municipal Operations Console Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CivicAdmin@2026
ADMIN_AUTH_SECRET=replace-with-random-secret
